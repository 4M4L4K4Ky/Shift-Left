#!/bin/sh
# Pre-commit hook para AegisCode AI / Shift-Left
# Ejecuta validaciones estáticas y tests antes de permitir el commit.

echo "[Shift-Left] Ejecutando análisis estático y ArchUnit..."

./mvnw clean test -Dtest=HexagonalArchitectureTest
ARCH_STATUS=$?

if [ $ARCH_STATUS -ne 0 ]; then
  echo "[ERROR] Violación de Arquitectura Hexagonal detectada. Commit abortado."
  exit 1
fi

./mvnw checkstyle:check
CS_STATUS=$?

if [ $CS_STATUS -ne 0 ]; then
  echo "[ERROR] Reglas estáticas (Max 3 ifs, 1 return, 0 magic numbers) incumplidas. Refactoriza antes de commitear."
  exit 1
fi

echo "[OK] Código limpio y arquitectura intacta. Procediendo con el commit."
exit 0